# ─── Sandbox directory (Research Agent writes fact_sheet here) ────────────────
SANDBOX_DIR=./sandbox

# ─── Output directory (Publisher Agent saves final .md posts here) ────────────
OUTPUT_DIR=./outputs

# ─── Data directory (Eval leaderboard lives here) ─────────────────────────────
DATA_DIR=./data

# ─── HITL mode ────────────────────────────────────────────────────────────────
HITL_MODE=web

# ─── API Port ─────────────────────────────────────────────────────────────────
API_PORT=3001

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# MongoDB connection URI (e.g., local MongoDB or Atlas connection string)
MONGO_DB=mongodb://localhost:27017/easydraft

# ─── API Keys ─────────────────────────────────────────────────────────────────
# NOT stored here. Each signed-in user enters their OpenAI (required) and
# Anthropic (optional) keys in the browser UI ("Manage API Key"). The backend
# stores them in MongoDB, encrypted with KEY_ENCRYPTION_SECRET (AES-256-GCM).

# ─── Firebase Auth (server-side token verification) ───────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Paste the ENTIRE downloaded JSON file content as ONE line here.
# Keep this secret — never commit it.
# Example shape: {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# If left empty, the backend runs in a local-dev fallback that does NOT verify tokens.
FIREBASE_SERVICE_ACCOUNT=

# ─── API key encryption ────────────────────────────────────────────────────────
# Secret used to encrypt each user's saved OpenAI/Anthropic keys at rest.
# Generate one with: openssl rand -hex 32
KEY_ENCRYPTION_SECRET=
