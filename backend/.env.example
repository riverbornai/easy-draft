# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Optional; if not provided here, you will be prompted to enter it in the browser
OPENAI_API_KEY=sk-...

# ─── Anthropic (used as OpenAI-compatible provider in Writer Agent) ───────────
# Leave empty if you don't have a Claude key; Writer Agent will skip Claude draft
ANTHROPIC_API_KEY=sk-ant-...

# ─── Sandbox directory (Research Agent writes fact_sheet here) ────────────────
SANDBOX_DIR=./sandbox

# ─── Output directory (Publisher Agent saves final .md posts here) ────────────
OUTPUT_DIR=./outputs

# ─── Data directory (Eval leaderboard lives here) ─────────────────────────────
DATA_DIR=./data

# ─── MongoDB Database ─────────────────────────────────────────────────────────
# MongoDB connection URI (e.g., local MongoDB or Atlas connection string)
MONGO_DB=mongodb://localhost:27017/ai-content-studio

